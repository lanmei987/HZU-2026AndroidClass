<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="15dp">
    <TextView android:id="@+id/tv_item_title" android:textSize="18sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/tv_item_author" android:layout_marginTop="5dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
</LinearLayout>